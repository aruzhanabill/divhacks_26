# Local Homebrew Postgres (no password, current OS user):
DATABASE_URL=postgresql://localhost:5432/safepath

# Docker Compose PostGIS from the repo root:
# DATABASE_URL=postgresql://safepath:safepath@localhost:5432/safepath

# Optional Socrata app token. The public API works without one.
# NYC_OPEN_DATA_APP_TOKEN=

# Photon photo reports: vision classify + optional geocode of a cross-street.
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4o-mini
# GOOGLE_MAPS_GEOCODE_KEY=
# Fallback pin if a photo has no GPS and no place text (demo only):
# PHOTON_DEFAULT_LAT=40.8075
# PHOTON_DEFAULT_LNG=-73.9626
